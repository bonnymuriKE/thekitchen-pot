---
// src/components/Privacy/ConsentManager.astro
import { Icon } from "astro-icon/components";
---

<div class="bg-white/80 backdrop-blur-lg rounded-3xl p-8 shadow-xl max-w-3xl mx-auto">
  <h3 class="text-2xl font-bold mb-6 flex items-center gap-3">
    <Icon name="mdi:shield-account" class="w-8 h-8 text-orange-600" />
    Your Privacy Controls
  </h3>

  <div class="space-y-4 text-gray-700">
    <p>
      You can control cookies, including analytics and affiliate tracking cookies, through your
      browser's settings at any time.
    </p>
    <p>
      If you've subscribed to our newsletter, you can unsubscribe using the link included in any
      email we send, or by emailing us at
      <a href="mailto:thekitchenpot8@gmail.com" class="text-orange-600 hover:text-orange-700 underline">
        thekitchenpot8@gmail.com
      </a>.
    </p>
  </div>
</div>
