import BonifaceImg from "@/data/assets/images/founder.jpeg"

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Boniface Muriuki",
  "jobTitle": "Founder & Editor",
  "description": "Boniface Muriuki is the founder and editor of The Kitchen Pot, where he writes about making small kitchens, apartments, and studios work better.",
