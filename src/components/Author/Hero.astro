---
// src/components/Author/Hero.astro
import { Image } from "astro:assets";
import bonifaceHeadshot from "@/data/assets/images/founder.jpeg";
---

<section class="bg-white py-16">
  <div class="container mx-auto px-4 flex flex-col md:flex-row items-center gap-12">
    <div class="md:w-1/3">
      <Image
        src={bonifaceHeadshot}
        alt="Boniface Muriuki, Founder and Editor of The Kitchen Pot"
        width={400}
        height={600}
        class="rounded-lg shadow-xl"
        loading="eager"
      />
    </div>

    <div class="md:w-2/3">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Boniface Muriuki
      </h1>
      <p class="text-xl text-gray-600 mb-6">
        Founder & Editor, The Kitchen Pot
      </p>
      <p class="text-gray-600 leading-relaxed max-w-2xl mb-8">
        Boniface founded The Kitchen Pot to help small-space cooks make the most of limited square footage. He writes and edits guides for apartments, studios, and small kitchens, some based on hands-on testing, others carefully researched, and always labeled as one or the other.
      </p>

      <a href="/contact-us" class="inline-block bg-primary-600 text-foreground px-6 py-3 rounded-lg hover:bg-primary-700 transition">
        Contact Boniface
      </a>
    </div>
  </div>
</section>