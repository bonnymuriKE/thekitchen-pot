---
import { Icon } from "astro-icon/components";

const quizQuestions = [
  {
    id: 1,
    question: "What's your biggest kitchen frustration right now?",
    options: [
      { id: "a", text: "I can't fit all my pots, pans, and bakeware", pillar: "storage-organization" },
      { id: "b", text: "I have way more cookware than I actually need", pillar: "cooking-for-one" },
      { id: "c", text: "My baking pans never stack or fit right", pillar: "small-space-bakeware" },
      { id: "d", text: "I want to grill but only have a balcony or patio", pillar: "balcony-patio-grilling" }
    ]
  },
  {
    id: 2,
    question: "How many people do you usually cook for?",
    options: [
      { id: "a", text: "Just me, most nights", pillar: "cooking-for-one" },
      { id: "b", text: "Me and one other person", pillar: "cooking-for-one" },
      { id: "c", text: "A full household", pillar: "storage-organization" }
    ]
  },
  {
    id: 3,
    question: "What's cluttering your cabinets the most?",
    options: [
      { id: "a", text: "Bakeware, muffin tins, and baking sheets", pillar: "small-space-bakeware" },
      { id: "b", text: "Pots, pans, and lids everywhere", pillar: "storage-organization" },
      { id: "c", text: "Small appliances I rarely use", pillar: "eco-friendly-appliances" }
    ]
  },
  {
    id: 4,
    question: "Do you have any outdoor cooking space?",
    options: [
      { id: "a", text: "Yes, a balcony or small patio", pillar: "balcony-patio-grilling" },
      { id: "b", text: "No outdoor space at all", pillar: "storage-organization" }
    ]
  },
  {
    id: 5,
    question: "What matters most when you're buying something new for the kitchen?",
    options: [
      { id: "a", text: "Saving energy and reducing waste", pillar: "eco-friendly-appliances" },
      { id: "b", text: "Saving space, above all else", pillar: "storage-organization" },
      { id: "c", text: "It has to do more than one job", pillar: "cooking-for-one" }
    ]
  }
];

const pillarInfo = {
  "storage-organization": {
    label: "Storage & Organization",
    description: "Your priority is fitting everything you already own into the space you have.",
    link: "/blog/tag/storage-organization/"
  },
  "cooking-for-one": {
    label: "Cooking for One (or Two)",
    description: "You don't need a full kitchen's worth of gear, just the right pieces for how you actually cook.",
    link: "/blog/tag/cooking-for-one/"
  },
  "eco-friendly-appliances": {
    label: "Eco-Friendly Appliances",
    description: "You care about energy use and waste as much as space, we've got picks for that.",
    link: "/blog/tag/eco-friendly-appliances/"
  },
  "small-space-bakeware": {
    label: "Small-Space Bakeware",
    description: "Baking pans are your specific cabinet nightmare, we have a whole guide just for this.",
    link: "/blog/tag/small-space-bakeware/"
  },
  "balcony-patio-grilling": {
    label: "Balcony & Patio Grilling",
    description: "You want to grill without a backyard, here's how to do it well in a small outdoor space.",
    link: "/blog/tag/balcony-patio-grilling/"
  }
};
---

<section class="py-16 bg-background">
  <div class="container mx-auto px-4">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-6 text-accent">Find Your Small-Space Kitchen Focus</h2>
      <p class="text-muted-foreground mb-8">Answer 5 quick questions and we'll point you to the guides most useful for your kitchen</p>

      <div class="bg-card p-8 rounded-xl shadow-sm" id="quiz-container">
        <div class="mb-6">
          <p class="text-lg font-medium mb-4 question-text"></p>
          <div class="space-y-3 options-container"></div>
        </div>

        <div class="flex items-center justify-between">
          <div class="text-sm text-muted-foreground progress-text"></div>
          <div class="h-2 bg-muted rounded-full w-3/4">
            <div class="h-full bg-primary rounded-full progress-bar"></div>
          </div>
        </div>
      </div>

      <div id="results" class="hidden mt-8 p-6 bg-primary/10 rounded-xl">
        <h3 class="text-xl font-bold mb-2 text-primary">Your Focus: <span class="result-label"></span></h3>
        <p class="text-accent mb-4 result-description"></p>
        <a href="#" class="result-link inline-block bg-primary text-white px-6 py-3 rounded-lg hover:bg-primary/90 transition-colors">
          See Guides for This
        </a>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ quizQuestions, pillarInfo }}>
  class QuizManager {
    constructor(questions, pillarInfo) {
      this.currentQuestion = 0;
      this.pillarCounts = {};
      this.questions = questions;
      this.pillarInfo = pillarInfo;
      this.container = document.getElementById('quiz-container');
      this.resultsDiv = document.getElementById('results');
      this.initQuiz();
    }

    initQuiz() {
      this.showQuestion();
      this.updateProgress();
    }

    showQuestion() {
      const question = this.questions[this.currentQuestion];
      const questionText = this.container.querySelector('.question-text');
      const optionsContainer = this.container.querySelector('.options-container');

      if (questionText && optionsContainer) {
        questionText.textContent = question.question;
        optionsContainer.innerHTML = '';

        question.options.forEach(option => {
          const button = document.createElement('button');
          button.className = 'w-full p-4 bg-card border rounded-lg hover:border-primary hover:bg-primary/5 transition-colors text-left';
          button.textContent = `➔ ${option.text}`;
          button.addEventListener('click', () => this.handleAnswer(option.pillar));
          optionsContainer.appendChild(button);
        });
      }
    }

    handleAnswer(pillar) {
      this.pillarCounts[pillar] = (this.pillarCounts[pillar] || 0) + 1;
      this.currentQuestion++;

      if (this.currentQuestion < this.questions.length) {
        this.showQuestion();
      } else {
        this.showResults();
      }
      this.updateProgress();
    }

    updateProgress() {
      const progressText = this.container.querySelector('.progress-text');
      const progressBar = this.container.querySelector('.progress-bar');

      if (progressText && progressBar) {
        const shown = Math.min(this.currentQuestion + 1, this.questions.length);
        progressText.textContent = `Question ${shown} of ${this.questions.length}`;
        const progress = (shown / this.questions.length) * 100;
        progressBar.style.width = `${progress}%`;
      }
    }

    showResults() {
      this.container.classList.add('hidden');
      this.resultsDiv.classList.remove('hidden');

      // Find the pillar with the most votes
      let topPillar = null;
      let topCount = -1;
      for (const [pillar, count] of Object.entries(this.pillarCounts)) {
        if (count > topCount) {
          topCount = count;
          topPillar = pillar;
        }
      }

      const info = this.pillarInfo[topPillar];
      const resultLabel = this.resultsDiv.querySelector('.result-label');
      const resultDescription = this.resultsDiv.querySelector('.result-description');
      const resultLink = this.resultsDiv.querySelector('.result-link');

      if (info && resultLabel && resultDescription && resultLink) {
        resultLabel.textContent = info.label;
        resultDescription.textContent = info.description;
        resultLink.href = info.link;
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new QuizManager(quizQuestions, pillarInfo);
  });
</script>
