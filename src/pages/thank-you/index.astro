---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Message Sent - The Kitchen Pot">
  <div class="container mx-auto px-4 py-24 text-center max-w-xl">
    <div class="text-6xl mb-6">✓</div>
    <h1 class="text-3xl font-bold mb-4 text-gray-900">Thanks for reaching out!</h1>
    <p class="text-gray-600 mb-8">
      We've received your message and will get back to you as soon as we can.
    </p>
    <a
      href="/"
      class="inline-block bg-gradient-to-t from-orange-400 to-accent text-white px-6 py-3 rounded-lg font-medium hover:from-card hover:to-slate-600 transition-all"
    >
      Back to Home
    </a>
  </div>
</Layout>
