---
// src/pages/about.astro
import Layout from '@/layouts/Layout.astro';
import InnovationHero from '@/components/About/InnovationHero.astro';
import MissionSection from '@/components/About/MissionSection.astro';
import ChefShowcase from '@/components/About/ChefShowcase.astro';

import heroImage from "@/data/assets/images/quitest-kitchen-appliances.jpg";
import founderImg from "@/data/assets/images/tiny-kitchen-will-this-fit.jpg";

// Founder & Editor
const chefData = {
  name: "Boniface Muriuki",
  role: "Founder & Editor",
  bio: "Passionate about helping small-space cooks make the most of limited square footage. Boniface founded The Kitchen Pot after one too many kitchen items that never should have made it past the front door of a small apartment.",
  image: founderImg,
  specialties: [
    "Vertical Cooking Systems",
    "Appliance Downsizing",
    "Clutter-Free Meal Prep",
    "Renter-Friendly Hacks"
  ]
};
---

<Layout title="About | The Kitchen Pot" description="Kitchen gear that respects your square footage. Real advice for small kitchens, apartments, and studios." robots="index, follow">

<InnovationHero
  title="Kitchen Gear That Respects Your Square Footage"
  subtitle="Real advice for small kitchens, apartments, and studios, not generic 'best of' lists"
  imageSrc={heroImage}
/>

<MissionSection />

<ChefShowcase chef={chefData} />
</Layout>
